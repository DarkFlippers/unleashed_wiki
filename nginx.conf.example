# Serve the built wiki.
#   npm run build
#   rsync -a --delete docs/.vitepress/dist/ /var/www/unleashed-wiki/
#
# Pages are ~200 KB raw and ~39 KB gzipped (VitePress inlines the navigation
# data for every language into each page), so compression matters here.

server {
    listen 80;
    listen [::]:80;
    server_name wiki.example.com;

    root /var/www/unleashed-wiki;
    index index.html;
    charset utf-8;

    # The site is built with cleanUrls, so /nfc/read is served from nfc/read.html.
    location / {
        try_files $uri $uri.html $uri/ =404;
    }

    error_page 404 /404.html;

    # Hashed bundles never change under the same name.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Screenshots and images are stable but may be regenerated.
    location ~* \.(png|jpe?g|gif|svg|webp|ico|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public";
    }

    # Both are generated by the build (set UL_SITE_URL so they carry the real
    # origin). Keep the cache short so a re-crawl picks up new pages quickly.
    location = /robots.txt  { expires 1h; add_header Cache-Control "public"; }
    location = /sitemap.xml { expires 1h; add_header Cache-Control "public"; }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 6;
    # text/html is always compressed when gzip is on and must not be listed here.
    gzip_types text/css text/plain application/javascript application/json
               image/svg+xml application/xml;

    # Language detection runs in the browser, so no Accept-Language mapping is
    # needed. English is served from the root; other languages live under
    # /ru/, /ua/, /de/, /fr/, /es/ and /it/.
}
